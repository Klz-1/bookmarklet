{
  "name": "browsing-history-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "A privacy-first Chrome extension that tracks your browsing habits and provides meaningful insights",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "zip": "cd dist && zip -r ../browsing-tracker.zip ."
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "dexie": "^4.2.1",
    "fuse.js": "^7.1.0",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.33",
    "@preact/preset-vite": "^2.10.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "@types/chrome": "^0.1.32",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.15",
    "autoprefixer": "^10.4.22",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.15"
  },
  "author": "",
  "license": "MIT"
}
